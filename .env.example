APP_NAME=tool-agent
ENVIRONMENT=development
SECRET_KEY=change-me-in-production

# Database Configuration
# Local Docker default.
DATABASE_URL=postgresql+psycopg://tool_agent:tool_agent@postgres:5432/tool_agent

# Use a Neon read-only role/connection string here if you created one.
# If you only have a single Neon URL for now, you can point this to the same database host/user,
# but the database-side SELECT-only guarantee will be weaker until you create a dedicated read-only role.
READONLY_DATABASE_URL=postgresql+psycopg://tool_agent_readonly:tool_agent_readonly@postgres:5432/tool_agent

# Redis (for caching, rate limiting, session storage)
REDIS_URL=redis://redis:6379/0

# Celery (background task queue)
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# JWT Authentication
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Rate Limiting
RATE_LIMIT_PER_HOUR=10

# Email Configuration (Mailhog locally; SendGrid or Resend in production)
# SendGrid example:
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USERNAME=apikey
# SMTP_PASSWORD=your-sendgrid-api-key
# SMTP_USE_TLS=true
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
EMAIL_FROM=no-reply@tool-agent.local
SALES_TEAM_EMAIL=sales@example.com
