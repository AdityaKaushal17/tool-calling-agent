APP_NAME=tool-agent
ENVIRONMENT=development
SECRET_KEY=change-me-in-production

# Database Configuration
# Local Docker default.
DATABASE_URL=postgresql+psycopg://tool_agent:tool_agent@postgres:5432/tool_agent

# Read-only role used by the agent's DB tool. On boot, `python -m app.db.bootstrap` creates this
# role if it doesn't exist and grants it SELECT only. For Neon, use the same host/db as DATABASE_URL
# with a new username and a long random password (Neon rejects weak passwords).
# postgres:// and postgresql:// URLs are accepted and mapped to the psycopg 3 driver automatically.
READONLY_DATABASE_URL=postgresql+psycopg://tool_agent_readonly:tool_agent_readonly@postgres:5432/tool_agent

# Redis (for caching, rate limiting, session storage)
REDIS_URL=redis://redis:6379/0

# Celery (background task queue). Optional: both default to REDIS_URL.
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Deployment helpers
# Run the Celery worker inside the web container (for hosts without free background workers).
RUN_WORKER_IN_PROCESS=false
# Seed this many demo signups on boot if the table is empty (0 = off).
SEED_IF_EMPTY=0

# JWT Authentication
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Rate Limiting
RATE_LIMIT_PER_HOUR=10

# Email Configuration (Mailhog locally; SendGrid or Resend in production)
# SendGrid example:
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USERNAME=apikey
# SMTP_PASSWORD=your-sendgrid-api-key
# SMTP_USE_TLS=true
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
EMAIL_FROM=no-reply@tool-agent.local
SALES_TEAM_EMAIL=sales@example.com
