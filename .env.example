APP_NAME=tool-agent
ENVIRONMENT=development
SECRET_KEY=change-me-in-production
DATABASE_URL=postgresql+psycopg://tool_agent:tool_agent@postgres:5432/tool_agent
READONLY_DATABASE_URL=postgresql+psycopg://tool_agent_readonly:tool_agent_readonly@postgres:5432/tool_agent
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
ACCESS_TOKEN_EXPIRE_MINUTES=60
RATE_LIMIT_PER_HOUR=10
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
EMAIL_FROM=no-reply@tool-agent.local
SALES_TEAM_EMAIL=sales@example.com
