APP_NAME=tool-agent
ENVIRONMENT=development
SECRET_KEY=change-me-in-production
# For local Docker, keep the default Postgres values.
# For Neon, paste the Neon connection string here.
DATABASE_URL=DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname
# Use a Neon read-only role/connection string here if you created one.
# If you only have a single Neon URL for now, you can point this to the same database host/user,
# but the database-side SELECT-only guarantee will be weaker until you create a dedicated read-only role.
READONLY_DATABASE_URL=postgresql+psycopg://tool_agent_readonly:tool_agent_readonly@postgres:5432/tool_agent
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
ACCESS_TOKEN_EXPIRE_MINUTES=60
RATE_LIMIT_PER_HOUR=10
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
EMAIL_FROM=no-reply@tool-agent.local
SALES_TEAM_EMAIL=sales@example.com
